# Supabase Environment Variables (Optional for local testing / Demo mode)
# If provided, the application connects directly to your live Supabase database with Row Level Security.
# If omitted or left as default, the app seamlessly runs in Demo Mode with persistent LocalStorage!

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
